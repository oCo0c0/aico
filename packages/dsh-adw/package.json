{
  "name": "@along/dsh-adw",
  "description": "adw requirement workbench for the dsh web GUI: a sidebar entry plus a requirement panel — agent-mediated fetch over MCP (the model dynamically reads mounted tool schemas and drives the calls; zero per-source code, any ONES/GitHub/GitLab/MCP server works by configuration), save documents host-side, pick a workspace (+mode/permission), and drive a real dsh session to develop the requirement. Hot-pluggable — no dsh source changes.",
  "version": "0.6.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "dependencies": {
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@along/adw-requirement-core": "workspace:*",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.7",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@types/node": "^20.14.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.5",
    "esbuild": "0.21.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~6.0.3"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
